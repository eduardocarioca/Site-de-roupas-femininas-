    <script>
        // Valid Coupons database
        const validCoupons = {
            'FEMME10': 0.10, // 10% discount
            'AURA15': 0.15,  // 15% discount
            'BEMVINDA': 0.20 // 20% discount
        };

        // Applied coupons tracker per product
        const appliedCoupons = {};

        // Function to apply discount coupon per product card
        function applyCoupon(productId, originalPrice) {
            const inputField = document.getElementById(`coupon-input-${productId}`);
            const msgBox = document.getElementById(`coupon-msg-${productId}`);
            const priceElement = document.getElementById(`price-${productId}`);
            const couponCode = inputField.value.trim().toUpperCase();

            if (!couponCode) {
                msgBox.textContent = "Digite um código de cupom.";
                msgBox.className = "coupon-message error";
                return;
            }

            if (appliedCoupons[productId]) {
                msgBox.textContent = "Cupom já aplicado nesta peça!";
                msgBox.className = "coupon-message error";
                return;
            }

            if (validCoupons[couponCode]) {
                const discountRate = validCoupons[couponCode];
                const discountedPrice = originalPrice * (1 - discountRate);
                
                priceElement.textContent = `R$ ${discountedPrice.toFixed(2).replace('.', ',')}`;
                msgBox.textContent = `Cupom '${couponCode}' aplicado (${discountRate * 100}% OFF)!`;
                msgBox.className = "coupon-message success";
                
                appliedCoupons[productId] = true;
                inputField.disabled = true;
            } else {
                msgBox.textContent = "Cupom inválido ou expirado.";
                msgBox.className = "coupon-message error";
            }
        }

        // Automatic Formatting for CEP Input (e.g., 00000-000)
        document.getElementById('cep-input').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 5) {
                value = value.substring(0, 5) + '-' + value.substring(5, 8);
            }
            e.target.value = value;
        });

        // CEP Shipping Calculation Function
        function calculateShipping() {
            const cepInput = document.getElementById('cep-input').value.trim();
            const resultBox = document.getElementById('shipping-result');

            if (cepInput.length < 9) {
                alert('Por favor, informe um CEP válido com 8 dígitos.');
                return;
            }

            // Simulate calculation response
            resultBox.style.display = 'block';
            resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    </script>
